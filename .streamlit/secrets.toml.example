# Copy this file to secrets.toml for local runs (it is git-ignored).
# On Streamlit Cloud, paste these lines into: App settings -> Secrets.

GROQ_API_KEY = "gsk_your_key_here"

# Optional settings (defaults shown)
# APP_ACCESS_CODE = "choose-a-password"        # restrict the app to people who know this code
# MODELS = "openai/gpt-oss-120b,openai/gpt-oss-20b"   # force a model order; empty = auto
# MAX_QUESTIONS_PER_SESSION = 40
# MAX_QUESTIONS_PER_MINUTE = 20                # all visitors together
# MAX_QUESTIONS_PER_DAY = 1500                 # all visitors together
# MAX_ROWS = 200000
